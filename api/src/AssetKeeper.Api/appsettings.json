{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "QuoteRefreshScheduler": {
    "Enabled": true,
    "IntervalSeconds": 3600,
    "RunOnStartup": true,
    "RetryCount": 1,
    "RetryDelaySeconds": 3,
    "IncludeFunds": true,
    "IncludeGold": true,
    "IncludeStocks": true
  },
  "AllowedHosts": "*"
}
